# Test Environment Variables
NODE_ENV=test
VUE_APP_ENV=test

# Test-specific settings
VUE_APP_API_BASE_URL=http://localhost:3000/api
VUE_APP_PREVIEW_PORT=4001
VUE_APP_TEST_MODE=true

# Disable analytics in test mode
VUE_APP_DISABLE_ANALYTICS=true

# Test database settings (if needed)
VUE_APP_TEST_DB_PATH=./test-data

# Electron settings for testing
ELECTRON_IS_DEV=1